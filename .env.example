# Firebase web config from Firebase console > Project settings > Your apps > SDK setup.
# For local development copy to .env.local; for the published site commit them as
# .env.production (these values are public by design; access is guarded by the
# Firestore rules and the Auth authorised domains, not by secrecy).
# When these are empty the app runs in local-only mode (data stays on this device).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
