rules_version = '2';

// Photos live under households/{hid}/... and are readable/writable only by
// members of that household. Uploads are limited to images up to 5 MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /households/{hid}/{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/households/$(hid)).data.memberUids;
      allow write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/households/$(hid)).data.memberUids
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
